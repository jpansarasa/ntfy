#!/usr/bin/env bash
#
# ntfy image update check (fetch + notify, does NOT apply).
#
# Pulls docker.io/binwiederhier/ntfy:latest and compares it to the image the
# running container is actually using. If they differ, an update is "staged":
# it is flagged (systemd journal + a marker file) but the container is left
# running the old image. Apply a staged update with:
#     sudo systemctl restart ntfy.service
# A reboot also applies it (the service's `up` uses the already-pulled image).
#
# Run by ntfy-update.timer; safe to run by hand.
#
set -euo pipefail

export DOCKER_UID="${DOCKER_UID:-2101}" DOCKER_GID="${DOCKER_GID:-2101}"

# Track whatever tag ntfy.service would actually start, or this reports on an
# image a restart would never run. The units pass NTFY_TAG in; a by-hand run
# gets it from the same pin file they use, then falls back to the same default.
# (`if` rather than `[ -r ] && .` -- the latter returns 1 when absent and would
# trip set -e.)
# Reads the RENDERED copy, the same file the units read, so this can never
# report on a different tag than a restart would apply. Parsed, never sourced.
if [ -r /etc/ntfy/image.env ]; then
    tag=$(grep -m1 -oP '^NTFY_TAG=\K.*' /etc/ntfy/image.env 2>/dev/null || true)
    tag=${tag%$'\r'}; tag=${tag#\"}; tag=${tag%\"}
    [ -n "$tag" ] && NTFY_TAG="$tag"
fi
export NTFY_TAG="${NTFY_TAG:-latest}"

IMAGE="docker.io/binwiederhier/ntfy:${NTFY_TAG}"
MARKER=/run/ntfy-update-available
COMPOSE=(/usr/bin/docker compose --file /opt/ntfy/compose.yml --project-name ntfy)
NOTIFY_ENV=/tank/ntfy/notify.env

# Best-effort ntfy push; never fails the check. Args: title, tags, body.
# Silently no-ops if the (root-only) notify env / token is absent.
# Runs in a SUBSHELL -- note the ( ) rather than { } -- so nothing it reads can
# leak into this script. It parses the file instead of sourcing it: `.` is
# arbitrary code execution as root, and the trust argument is weakest exactly on
# the restore path, where a zfs receive from a compromised backup host would
# otherwise own this box at the next timer elapse. Every skip and failure says so
# on stderr, which the timer captures: silence used to mean "no updates" and "the
# token was revoked eleven months ago" indistinguishably, which is a poor property
# for the channel whose whole job is telling you about updates.
notify() (
    if [ ! -r "$NOTIFY_ENV" ]; then
        echo "check-update: no push: $NOTIFY_ENV is absent or unreadable" >&2
        return 0
    fi
    local url topic token
    url=$(grep -m1 -oP '^NTFY_URL=\K.*'   "$NOTIFY_ENV" 2>/dev/null || true)
    topic=$(grep -m1 -oP '^NTFY_TOPIC=\K.*' "$NOTIFY_ENV" 2>/dev/null || true)
    token=$(grep -m1 -oP '^NTFY_TOKEN=\K.*' "$NOTIFY_ENV" 2>/dev/null || true)
    url="${url:-http://localhost:8123}"; topic="${topic:-updates}"
    if [ -z "$token" ]; then
        echo "check-update: no push: NTFY_TOKEN is empty in $NOTIFY_ENV" >&2
        return 0
    fi
    # Token on stdin, not argv: /proc has no hidepid, so a command line would
    # expose it to every local user for the duration of the request.
    if ! printf 'Authorization: Bearer %s\n' "$token" |
        curl -fsS --max-time 10 -H @- \
            -H "Title: ${1}" -H "Tags: ${2}" -d "${3}" \
            -o /dev/null "${url}/${topic}"; then
        echo "check-update: ntfy push FAILED (token revoked? topic? url=$url)" >&2
    fi
    return 0
)

# Fetch the latest tag. This updates the local :latest pointer only; it does
# NOT touch the running container.
"${COMPOSE[@]}" pull --quiet

# $() strips the trailing newline; a failed inspect yields "" -> defaulted to
# "none". (Avoid `|| echo none`, which can leave a stray blank line in the value.)
running=$(docker inspect --format '{{.Image}}' ntfy 2>/dev/null || true)
latest=$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null || true)
running=${running:-none}
latest=${latest:-none}

# If the container isn't running, `docker inspect` yields "none", which would
# otherwise look identical to "a newer image is staged" and fire a spurious
# "update available" push (e.g. during a restart/maintenance window). Skip.
if [ "$running" = "none" ]; then
    echo "ntfy container not running; skipping update check." >&2
    exit 0
fi

if [ "$running" != "$latest" ]; then
    {
        echo "ntfy update staged (not applied)."
        echo "running: $running"
        echo "latest:  $latest"
        echo "checked: $(date -Is)"
        echo "Apply:   sudo systemctl restart ntfy.service"
    } | tee "$MARKER" >&2
    notify "ntfy update available" "package,ntfy" \
        "New :latest image staged. Apply: sudo systemctl restart ntfy.service"
    exit 0
fi

rm -f "$MARKER"
echo "ntfy already running the current $NTFY_TAG image ($latest)."

# Pinned: the running image matches the pin, so nothing is staged and nothing
# above fired. A pin is meant to be temporary, though, so report when upstream
# moves -- that is the signal the bad release was superseded and the pin can go.
# Deliberately NOT written to $MARKER: a restart applies none of this.
if [ "$NTFY_TAG" != latest ]; then
    docker pull --quiet docker.io/binwiederhier/ntfy:latest >/dev/null 2>&1 || true
    upstream=$(docker image inspect --format '{{.Id}}' docker.io/binwiederhier/ntfy:latest 2>/dev/null || true)
    if [ -n "$upstream" ] && [ "$upstream" != "$running" ]; then
        echo "note: pinned to $NTFY_TAG; upstream :latest has moved ($upstream)."
        echo "      un-pin: remove /tank/ntfy/image.env, then re-run /opt/ntfy/install."
        notify "ntfy pin can likely be retired" "pushpin,ntfy" \
            "Pinned to $NTFY_TAG; upstream :latest has moved. Un-pin: remove /tank/ntfy/image.env, then sudo /opt/ntfy/install"
    fi
fi
