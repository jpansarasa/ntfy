[Unit]
Description=ntfy image update check (fetch :latest, notify if newer than running)
Documentation=file:/opt/ntfy/check-update
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/ntfy/compose.yml

[Service]
Type=oneshot
Environment=DOCKER_UID=2101 DOCKER_GID=2101
# Must agree with ntfy.service, or the checker reports on a different image
# than the one a restart would actually run. See that unit for the pin story.
Environment=NTFY_TAG=latest
EnvironmentFile=-/etc/ntfy/image.env
ExecStart=/opt/ntfy/check-update
